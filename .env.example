# ==============================================================================
# IntraSphere Labs IMS — Environment Configuration Guide for Vercel
# ==============================================================================
# Add these variables in your Vercel Project Settings -> Environment Variables:

# Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Resend Email Integration
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_FROM_EMAIL=IntraSphere Labs IMS <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=teamintrasphere@gmail.com
